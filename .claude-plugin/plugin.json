{
  "name": "attack-surface-mcp-server",
  "version": "0.1.0",
  "description": "Passive external attack-surface mapping: CT subdomains, DNS, TLS, HTTP posture, RDAP/WHOIS, Shodan.",
  "author": {
    "name": "cyanheads",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/attack-surface-mcp-server",
  "repository": "https://github.com/cyanheads/attack-surface-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "attack-surface-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/attack-surface-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "SHODAN_API_KEY": "${SHODAN_API_KEY}",
        "CERTSPOTTER_API_KEY": "${CERTSPOTTER_API_KEY}"
      }
    }
  }
}
